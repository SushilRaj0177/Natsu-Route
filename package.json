{
  "name": "natsuroute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Door-to-door train and bus routes that keep you out of the summer sun, for Tokyo's 23 wards",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data:fetch": "tsx pipeline/fetch.ts",
    "data:build": "tsx pipeline/build.ts",
    "data:verify": "tsx pipeline/verify.ts",
    "data:replay": "tsx pipeline/heat-replay.ts",
    "data": "npm run data:fetch && npm run data:build && npm run data:replay",
    "geo": "python3 geo/plateau.py && python3 geo/osm.py && python3 geo/hokonavi.py && python3 geo/shelters.py && python3 geo/pack.py",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build && esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@fontsource/biz-udpgothic": "^5.2.6",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/stream-json": "^1.7.8",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.24.2",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stream-json": "^1.9.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "yauzl": "^3.4.0"
  }
}
