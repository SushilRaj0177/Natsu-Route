# Copy to .env and fill in. .env is git-ignored.
#
# Standard ODPT key (https://developer.odpt.org): Tokyo Metro, Toei, TX, Rinkai,
# Tama Monorail, Yokohama Subway, Yurikamome.
ODPT_API_KEY=
# ODPT Challenge 2026 token: JR East, Tokyu, Odakyu, Keio, Seibu, Tobu, Keikyu,
# Sotetsu. Licensed for the Challenge entry only.
ODPT_CHALLENGE_TOKEN=
# Optional. Port for the API server (defaults to 8787).
PORT=
