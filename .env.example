# Copy to .env and fill in. .env is git-ignored.
#
# Standard ODPT key (https://developer.odpt.org): Tokyo Metro, Toei (subway
# and buses), TX, Rinkai, Tama Monorail, Yokohama Subway, Yurikamome, Tokyu
# Bus, Seibu Bus.
ODPT_API_KEY=
# ODPT Challenge 2026 token: JR East, Tokyu, Odakyu, Keio, Seibu, Tobu, Keikyu,
# Sotetsu, Kokusai Kogyo Bus. Licensed for the Challenge entry only.
ODPT_CHALLENGE_TOKEN=
# Shown on the About page as the developer contact (ODPT's developer
# guideline asks apps to give one).
CONTACT_EMAIL=
# Optional. Port for the API server (defaults to 8787).
PORT=
